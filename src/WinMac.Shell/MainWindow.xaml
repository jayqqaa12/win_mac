<Window
    x:Class="WinMac.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8">
            <TextBlock
                Text="WinMac"
                FontSize="48"
                FontWeight="SemiBold"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="M0 脚手架 — WinUI 3 非打包自包含"
                FontSize="16"
                Opacity="0.7"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="StatusText"
                FontSize="13"
                Opacity="0.6"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>