<Window
    x:Class="WinMac.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ctrl="using:WinMac.Shell.Controls"
    mc:Ignorable="d"
    Title="WinMac">

    <Grid Background="{ThemeResource WindowBackground}" Padding="40">
        <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ctrl:MacTextBlock
                x:Name="TitleLabel"
                Text="WinMac"
                FontSize="44" />

            <TextBlock
                Text="macOS 质感文字引擎（M1 主题 + 文字 + 设置）"
                FontSize="14"
                Opacity="0.7"
                Foreground="{ThemeResource TextSecondary}"
                HorizontalAlignment="Center" />

            <ctrl:MacTextBlock
                x:Name="SampleA"
                Text="灰度 AA · gamma 1.8 · 对比 0.9 · 柔化 0.35"
                FontSize="16"
                Gamma="1.8" Contrast="0.9" Softness="0.35"
                HorizontalAlignment="Center" />
            <ctrl:MacTextBlock
                x:Name="SampleB"
                Text="更实：gamma 1.2 · 对比 1.4"
                FontSize="16"
                Gamma="1.2" Contrast="1.4" Softness="0.1"
                HorizontalAlignment="Center" />

            <ctrl:CapsuleButton
                x:Name="OpenSettingsButton"
                Content="打开设置"
                Width="180"
                HorizontalAlignment="Center"
                Margin="0,18,0,0"
                Click="OnOpenSettings" />
        </StackPanel>
    </Grid>
</Window>