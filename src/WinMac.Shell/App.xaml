<Application
    x:Class="WinMac.Shell.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- 亮色 -->
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="WindowBackgroundColor">#F2F2F7</Color>
                    <Color x:Key="TextPrimaryColor">#1C1C1E</Color>
                    <Color x:Key="TextSecondaryColor">#6E6E73</Color>
                    <Color x:Key="TextTertiaryColor">#AEAEB2</Color>
                    <Color x:Key="ControlFillColor">#1D1D1F0A</Color>
                    <Color x:Key="DividerColor">#3C3C431A</Color>
                    <Color x:Key="AccentColor">#007AFF</Color>

                    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}" />
                    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
                    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
                    <SolidColorBrush x:Key="TextTertiary" Color="{StaticResource TextTertiaryColor}" />
                    <SolidColorBrush x:Key="ControlFill" Color="{StaticResource ControlFillColor}" />
                    <SolidColorBrush x:Key="Divider" Color="{StaticResource DividerColor}" />
                    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
                </ResourceDictionary>

                <!-- 深色 -->
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="WindowBackgroundColor">#1C1C1E</Color>
                    <Color x:Key="TextPrimaryColor">#F2F2F7</Color>
                    <Color x:Key="TextSecondaryColor">#98989D</Color>
                    <Color x:Key="TextTertiaryColor">#636366</Color>
                    <Color x:Key="ControlFillColor">#F2F2F70A</Color>
                    <Color x:Key="DividerColor">#FFFFFF1F</Color>
                    <Color x:Key="AccentColor">#0A84FF</Color>

                    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}" />
                    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
                    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
                    <SolidColorBrush x:Key="TextTertiary" Color="{StaticResource TextTertiaryColor}" />
                    <SolidColorBrush x:Key="ControlFill" Color="{StaticResource ControlFillColor}" />
                    <SolidColorBrush x:Key="Divider" Color="{StaticResource DividerColor}" />
                    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 共享样式：设置窗口卡片 / 区块标题 / 提示 -->
            <Style x:Key="SettingCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFill}" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="BorderBrush" Value="{ThemeResource Divider}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="20,18,20,18" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
            </Style>
            <Style x:Key="HintTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondary}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>