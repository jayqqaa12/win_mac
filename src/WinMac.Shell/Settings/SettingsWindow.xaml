<Window
    x:Class="WinMac.Shell.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctrl="using:WinMac.Shell.Controls"
    mc:Ignorable="d"
    Title="WinMac 设置">

    <Grid Background="{ThemeResource WindowBackground}" Padding="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Orientation="Horizontal" Spacing="10" Grid.Row="0" Margin="0,0,0,20">
            <ctrl:MacTextBlock Text="WinMac 设置" FontSize="28" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">

                <!-- 外观卡片 -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="主题" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondary}" />
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" SelectedValuePath="Tag">
                                <ComboBoxItem Content="跟随系统" Tag="System" />
                                <ComboBoxItem Content="浅色" Tag="Light" />
                                <ComboBoxItem Content="深色" Tag="Dark" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Dock 停靠栏卡片 -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Dock 停靠栏" Style="{StaticResource SectionTitleStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="启用" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondary}" />
                            <ToggleSwitch x:Name="DockToggle" Grid.Column="1" OnContent="" OffContent="" />
                        </Grid>
                        <Grid ColumnSpacing="12" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="隐藏模式" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondary}" />
                            <ComboBox x:Name="HideModeCombo" Grid.Column="1" SelectedValuePath="Tag">
                                <ComboBoxItem Content="常显" Tag="Always" />
                                <ComboBoxItem Content="自动隐藏" Tag="AutoHide" />
                                <ComboBoxItem Content="智能隐藏" Tag="SmartHide" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Text="说明：隐藏模式更多选项将在后续里程碑接入；开关与模式保存后重启应用生效。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 桌面小组件 / 通用卡片 -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="桌面小组件与系统" Style="{StaticResource SectionTitleStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="桌面小组件" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondary}" />
                            <ToggleSwitch x:Name="WidgetsToggle" Grid.Column="1" OnContent="" OffContent="" />
                        </Grid>
                        <Grid ColumnSpacing="12" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="开机自启" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondary}" />
                            <ToggleSwitch x:Name="AutoStartToggle" Grid.Column="1" OnContent="" OffContent="" />
                        </Grid>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Text="说明：小组件(时钟/CPU/内存/日历)与开机自启开关修改后保存生效。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 文字质感卡片 -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="18">
                        <TextBlock Text="文字质感（macOS）" Style="{StaticResource SectionTitleStyle}" />

                        <!-- 实时预览 -->
                        <Border Background="{ThemeResource ControlFill}" CornerRadius="12"
                                Padding="16,14,16,14">
                            <ctrl:MacTextBlock
                                x:Name="PreviewLabel"
                                Text="WinMac · 灰度 AA 文字预览"
                                FontSize="26"
                                Gamma="1.8"
                                Contrast="0.9"
                                Softness="0.35" />
                        </Border>

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Text="说明：真·逐字形灰度 gamma 需原生注入器(Milestone 5)；此处把三参数映射到字重/透明度/位图缓存(去除 ClearType 彩边)。"
                                   TextWrapping="Wrap" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Gamma" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondary}" />
                            <Slider x:Name="GammaSlider" Grid.Column="1"
                                    Minimum="1.0" Maximum="3.0" StepFrequency="0.05" Value="1.8"
                                    ValueChanged="OnMacParamChanged" />
                            <TextBlock x:Name="GammaValue" Grid.Column="2" Text="1.80"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextSecondary}" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="对比度" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondary}" />
                            <Slider x:Name="ContrastSlider" Grid.Column="1"
                                    Minimum="0.0" Maximum="1.5" StepFrequency="0.05" Value="0.9"
                                    ValueChanged="OnMacParamChanged" />
                            <TextBlock x:Name="ContrastValue" Grid.Column="2" Text="0.90"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextSecondary}" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="柔化度" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondary}" />
                            <Slider x:Name="SoftnessSlider" Grid.Column="1"
                                    Minimum="0.0" Maximum="1.0" StepFrequency="0.05" Value="0.35"
                                    ValueChanged="OnMacParamChanged" />
                            <TextBlock x:Name="SoftnessValue" Grid.Column="2" Text="0.35"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextSecondary}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,20,0,0">
            <ctrl:CapsuleButton x:Name="ResetButton" Content="恢复默认" Click="OnReset" />
            <ctrl:CapsuleButton x:Name="SaveButton" Content="保存" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>